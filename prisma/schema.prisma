generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  plano                String    @default("gratis") // gratis | pro | contador
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  operacoes          Operacao[]
  resetTokens        PasswordResetToken[]
  exchangeConnections ExchangeConnection[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Operacao {
  id            String   @id @default(cuid())
  userId        String
  tipo          String // compra | venda
  cripto        String
  quantidade    Float
  valorTotal    Float
  precoUnitario Float
  data          DateTime
  exchange      String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, data])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model ExchangeConnection {
  id           String    @id @default(cuid())
  userId       String
  exchange     String    // "binance" | "mercado-bitcoin" | "bybit" | etc.
  label        String?   // apelido opcional do usuário
  apiKey       String    // chave pública — não precisa criptografar
  apiSecret    String    @db.Text // criptografado com AES-256-GCM
  active       Boolean   @default(true)
  lastSyncAt   DateTime?
  lastSyncOps  Int?      // quantas ops foram importadas no último sync
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange]) // um usuário só conecta cada exchange uma vez
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // null = ação anônima (ex: tentativa de registro com email já em uso)
  action    String   // login | register | operacao_delete | export_csv | export_pdf | login_failed
  ip        String?
  metadata  Json?    // dados extras (ex: cripto deletada, quantidade, etc.)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
