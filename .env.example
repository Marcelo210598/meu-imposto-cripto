# Meu Imposto Cripto - Variáveis de Ambiente

# ===================
# Analytics (opcional)
# ===================

# Plausible Analytics (privacy-friendly, recomendado)
# Obtenha em: https://plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="workspace-tau-olive.vercel.app"

# Google Analytics
# Obtenha em: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ===================
# Database (Neon PostgreSQL)
# ===================

# Neon PostgreSQL — obtenha em: https://neon.tech
# Use o pooler URL (porta 6543) com pgbouncer=true para compatibilidade com Prisma
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30"

# ===================
# Autenticação (NextAuth v5)
# ===================

# Gere com: openssl rand -hex 32  ou  npx auth secret
AUTH_SECRET="seu-secret-aleatorio-aqui"

# URL base da aplicação
AUTH_URL="http://localhost:3000"

# ===================
# APIs de Exchanges (futuro)
# ===================

# Binance
# BINANCE_API_KEY=""
# BINANCE_API_SECRET=""

# Mercado Bitcoin
# MB_API_KEY=""
# MB_API_SECRET=""
